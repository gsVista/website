# Managed Postgres connection string (Neon, Vercel Postgres, or local Postgres).
POSTGRES_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Admin password for the /admin portal.
ADMIN_PASSWORD=change-this-to-a-strong-password

# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
